{
  "name": "wbe-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build && node scripts/verify-methodology-production.mjs",
    "type-check": "vue-tsc --build",
    "geo:boundaries:build": "node scripts/build-map-boundaries.mjs",
    "geo:boundaries:build:preserve-index": "node scripts/build-map-boundaries.mjs --preserve-presentation-index",
    "geo:boundaries:check": "node scripts/build-map-boundaries.mjs --check",
    "geo:admin2:research:audit": "node scripts/audit-admin2-supplement-research.mjs",
    "geo:admin2:geometry:audit": "node scripts/audit-admin2-supplement-geometry.mjs",
    "geo:admin2:scope:audit": "node scripts/audit-admin2-supplement-scope.mjs",
    "geo:global-city:prepare": "npm run geo:admin2:research:audit && npm run geo:admin2:geometry:audit && node scripts/prepare-global-admin2.mjs && npm run geo:admin2:scope:audit",
    "tiles:preview:names:prepare": "node scripts/prepare-preview-names.mjs",
    "tiles:regions:prepare": "npm run geo:boundaries:build:preserve-index && npm run geo:global-city:prepare && node scripts/build-wbe-regions.mjs --prepare-only",
    "tiles:regions:build": "npm run geo:boundaries:build:preserve-index && npm run geo:global-city:prepare && node scripts/build-wbe-regions.mjs",
    "tiles:regions:verify": "node scripts/verify-wbe-regions.mjs",
    "tiles:preview:build": "npm run geo:boundaries:build && npm run geo:global-city:prepare && node scripts/build-preview-composite.mjs",
    "tiles:preview:audit": "node scripts/audit-preview-map.mjs",
    "tiles:preview:verify": "node scripts/verify-preview-composite.mjs",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "echarts": "^6.1.0",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.2",
    "pmtiles": "^4.4.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "mapshaper": "^0.6.113",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "pbf": "^4.0.2",
    "polygon-clipping": "^0.15.7",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
